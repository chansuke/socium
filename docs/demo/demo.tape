# Run through record.sh, which starts the loopback model and sets the environment.
Output docs/assets/demo.gif

Set Shell bash
Set FontSize 15
Set Width 1560
Set Height 860
Set Padding 24
Set TypingSpeed 45ms

Hide
Type "export PS1='$ ' && cd $DEMO_WS && clear"
Enter
Show

Type "socium"
Sleep 400ms
Enter
Sleep 2s

Type "test_slug fails, can you fix it?"
Sleep 500ms
Enter
Sleep 3s
Type "y"
Sleep 7s
Type "y"
Sleep 6s
Screenshot docs/assets/demo.png
Sleep 1s
