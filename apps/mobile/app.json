{
  "expo": {
    "name": "Socium",
    "slug": "socium",
    "version": "0.1.0",
    "userInterfaceStyle": "dark",
    "extra": {
      "eas": {
        "projectId": "832f8045-5851-45ad-8511-3209a80b213d"
      }
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.chansuke.socium",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-foreground.png",
        "backgroundColor": "#101417"
      }
    },
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.chansuke.socium",
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "owner": "chansuke2027",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Socium to scan a pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
