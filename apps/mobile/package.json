{
  "name": "@socium/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/*.test.ts",
    "android": "expo run:android",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "ios": "expo run:ios",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@socium/client": "0.1.0",
    "expo": "~58.0.26",
    "expo-camera": "~58.0.14",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
