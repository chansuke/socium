{
  "name": "socium-clients",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:clients": "npm run start -w @socium/server",
    "test:clients": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @socium/web",
    "build:web": "npm run build -w @socium/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
