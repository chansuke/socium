# Socium model registry. Copy to ~/.config/socium/models.toml
# (or $XDG_CONFIG_HOME/socium/models.toml, or the path in SOCIUM_MODELS_FILE).
#
# Never write keys here: api_key_env names the environment variable that
# holds each key. Built-in models (opus, sonnet, haiku on Anthropic) are
# always available; entries below are added to them, and an entry with a
# built-in alias replaces it. Model IDs were checked against each
# provider's documentation on 2026-11-13.

# Model selected when neither /model nor MODEL chose one.
default = "opus"

# DeepSeek: https://platform.deepseek.com (API Keys; prepaid balance).
# The Anthropic-compatible endpoint accepts x-api-key or Bearer.
[providers.deepseek]
wire = "anthropic"
base_url = "https://api.deepseek.com/anthropic"
api_key_env = "DEEPSEEK_API_KEY"
auth = "bearer"

# Z.ai (GLM): https://z.ai/manage-apikey/apikey-list
# A Standard API key works with this endpoint and needs a balance
# ([1113] Insufficient balance otherwise). Coding Plan keys are created
# separately, under API Keys -> Personal Coding Plan.
[providers.zai]
wire = "anthropic"
base_url = "https://api.z.ai/api/anthropic"
api_key_env = "ZAI_API_KEY"
auth = "bearer"

# OpenAI: https://platform.openai.com (API keys; prepaid). The Responses
# API lets reasoning models call tools; Chat Completions rejects tools with
# reasoning on GPT-6 Astra. Ollama, OpenRouter, and other compatible APIs
# use wire = "openai-chat".
[providers.openai]
wire = "openai-responses"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"

# Ollama Cloud: https://ollama.com (account settings -> API keys).
# [providers.ollama]
# wire = "openai-chat"
# base_url = "https://ollama.com/v1"
# api_key_env = "OLLAMA_API_KEY"

# OpenRouter: https://openrouter.ai (Keys).
# [providers.openrouter]
# wire = "openai-chat"
# base_url = "https://openrouter.ai/api/v1"
# api_key_env = "OPENROUTER_API_KEY"

# DeepSeek-V4.1-Flash. DeepSeek rejects unknown non-Claude names with 400.
[[models]]
alias = "ds-flash"
provider = "deepseek"
id = "deepseek-flash"
description = "DeepSeek-V4.1-Flash, fast and inexpensive"
features = ["effort"]
context_window = 1000000
max_output_tokens = 32000

[[models]]
alias = "ds-pro"
provider = "deepseek"
id = "deepseek-v4-pro"
description = "DeepSeek-V4-Pro for harder tasks"
features = ["effort"]
context_window = 1000000
max_output_tokens = 32000

# GLM-5.3 always reasons; 1M context, up to 128K output.
[[models]]
alias = "glm"
provider = "zai"
id = "glm-5.3"
description = "GLM-5.3, always reasons"
context_window = 1000000
max_output_tokens = 32000

# Optional fields:
#   description = "..."
#     One line shown in the /model picker.
#   features = ["adaptive_thinking", "effort", "eager_input_streaming",
#               "anthropic_text_editor", "prompt_caching"]
#     Anthropic extensions to send; omit for compatible endpoints. On the
#     OpenAI wires only "effort" applies: openai-chat sends it as
#     reasoning_effort; on openai-responses it marks a reasoning model,
#     whose summaries are shown and whose encrypted reasoning is sent back
#     across tool calls, and EFFORT is sent as reasoning.effort.
#     "prompt_caching" sends a top-level cache_control, so each round reads
#     the shared history from the cache; built-in Claude models have it.
#   compact_model = "<alias>"
#     Model that summarizes history; defaults to this model.
#   compact_at_tokens = 200000
#     Prompt size at which history is compacted. Defaults to 200000 or 80%
#     of the input budget, whichever is lower; must be below context_window.
#   price = { input = 0.28, output = 0.42, cache_read = 0.028 }
#     US dollars per million tokens, used only to show the session cost.
#     cache_read and cache_write default to the input price. Socium ships
#     no prices, so without this field no cost is shown.
#
# A local server (http is allowed only on localhost), such as Ollama's
# OpenAI-compatible API. One that takes no key needs no api_key_env, and
# its requests carry no key header; add api_key_env when it asks for one:
#
# [providers.local]
# wire = "openai-chat"
# base_url = "http://localhost:11434/v1"
#
# or one speaking the Anthropic Messages format:
#
# [providers.local]
# wire = "anthropic"
# base_url = "http://localhost:11434"

# GPT-6 Astra, OpenAI's flagship for coding as of 2026-11-13 (the GPT-5
# family is no longer listed). "effort" marks it as a reasoning model.
[[models]]
alias = "gpt"
provider = "openai"
id = "gpt-6-astra"
description = "GPT-6 Astra for complex reasoning and coding"
features = ["effort"]
context_window = 1050000
max_output_tokens = 32000
